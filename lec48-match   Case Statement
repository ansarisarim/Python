print("*" * 50)
print("Press 0 to 5  →  Convert Integer to Hex & Binary")
print("Press 6 to 10 →  Convert Binary to Hex & Octal")
print("*" * 50)
x = int(input("Enter your first number: "))

match x:
    case 0 | 1 | 2 | 3 | 4 | 5:
        a = int(input("Enter the int value: "))
        hexa = hex(a)
        binary = bin(a)
        print("{}, Hexadecimal value is {}".format(a, hexa))
        print("{}, Binary value is {}".format(a, binary))

    case 6 | 7 | 8 | 9 | 10:
        b = input("Enter the binary value: ")
        hexa = hex(int(b, 2))
        octa = oct(int(b, 2))
        print("{}, Hexadecimal value is {}".format(b, hexa))
        print("{}, Octal value is {}".format(b, octa))

#a=oct(12)
# int(a,8)
# 12

    case 11 | 12 | 13 | 14 | 15 :
        print("octal to int ,Hex & Binary")
        a = input("Enter the int value: ")
        bin_value = bin(int(a,8))
        int_valuse = int(a,8)
        hex_value = hex(int(a, 8))
        print("{}, Hexadecimal value is {}".format(a,  bin_value))
        print("{}, Binary value is {}".format(a, int_valuse))
        print("{}, Binary value is {}".format(a, bin_value))


    case 16 | 17 | 18 | 19 | 20 :
        print("hexadecimal  to int ,oct & Binary")
        a = input("Enter the hexadecimal value: ")
        bin_value = bin(int(a, 16))
        int_valuse = int(a, 16)
        hex_value = oct(int(a, 16))
        print("{}, Hexadecimal value is {}".format(a,  bin_value))
        print("{}, Binary value is {}".format(a, int_valuse))
        print("{}, Binary value is {}".format(a, bin_value))

    case _:
        print("Please enter number only between 0 to 10")

print("Program completely executed")
