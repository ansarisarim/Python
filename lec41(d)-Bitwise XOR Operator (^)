Bitwise XOR operator (^)
>>> 12^15
3

>>> 1^2
3

>>> 32^12
44


>>> {1, 3, 2, 4}^{1, 5, 6, 3, 2, 1}
{4, 5, 6}


>>> a = {1, 3, 2, 4}
>>> b = {1, 5, 6, 3, 2, 1}
>>> print(a ^ b)
{4, 5, 6}
>>> print(a.symmetric_difference(b))
{4, 5, 6}

# Both same result!
print(a ^ b)                        # {4, 5, 6}
print(a.symmetric_difference(b))    # {4, 5, 6}

