n = int(input("Enter the value of n: "))

if n < 0:
    print("Invalid input")
else:
    if n < 5:
        print("Number is valid but less than 5, so nothing to print")
    else:
        while n >= 5:
            print("This is valid value:", n)
            n = n - 1

print("Program finished")


